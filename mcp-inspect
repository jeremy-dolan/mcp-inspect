def base_headers() -> dict:
    """What this tool sends on its own, before the caller adds anything to it.

    A cross-origin redirect falls back to these, because a --header may
    override one of them rather than add a new one: dropping the caller's
    User-Agent must not leave urllib to supply its own, and dropping their
    Accept must not leave the request with no Accept at all.
    """
    # The connection layer sorts these after urllib and http.client have
    # supplied their automatic headers.
    return {
        "Accept": "application/json, text/event-stream",
        "Content-Type": "application/json",
        "User-Agent": IDENTITY["http_user_agent"],
    }

